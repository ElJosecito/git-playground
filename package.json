{
  "name": "git-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Aprende Git en el navegador: un simulador de Git real con grafo animado, niveles guiados y pull requests simulados.",
  "license": "MIT",
  "author": "ElJosecito",
  "homepage": "https://eljosecito.github.io/git-playground/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJosecito/git-playground.git"
  },
  "bugs": {
    "url": "https://github.com/ElJosecito/git-playground/issues"
  },
  "keywords": [
    "git",
    "learn-git",
    "education",
    "simulator",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:chunks": "node scripts/check-chunks.mjs",
    "preview": "vite preview",
    "test": "cross-env TZ=UTC vitest run",
    "test:watch": "cross-env TZ=UTC vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
